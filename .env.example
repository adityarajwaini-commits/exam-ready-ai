GEMINI_API_KEY=AIzaSyCfd337B94VRVAs3k2xHklDw1xyJyLIkuA


# ==========================================
# Authentication Secret
# ==========================================

# JWT Secret for authentication (MUST BE SECURE)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
