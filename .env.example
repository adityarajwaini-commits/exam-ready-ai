# ExamReady AI - Environment Variables Template
# Copy this file to .env and fill in your values

# ==========================================
# MongoDB Configuration
# ==========================================

# Option 1: Local MongoDB
MONGODB_URI=mongodb://localhost:27017

# Option 2: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/examready_db?retryWrites=true&w=majority

# Database Name
DB_NAME=examready_db

# ==========================================
# Application URL
# ==========================================

# For development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# For production (change to your domain)
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ==========================================
# Google Gemini AI Configuration
# ==========================================

# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Authentication Secret
# ==========================================

# JWT Secret for authentication (MUST BE SECURE)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=your_secure_random_secret_key_here

# Example secure key (DO NOT USE THIS - Generate your own):
# NEXTAUTH_SECRET=a5373d7be6f42f6dc144a7e6b4c13db22a91ddada639852faaee216ea164f248

# ==========================================
# CORS Configuration
# ==========================================

# Allow all origins (development only)
CORS_ORIGINS=*

# For production, specify your domain:
# CORS_ORIGINS=https://yourdomain.com

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================

# 1. NEVER commit .env file to Git
# 2. Generate a unique NEXTAUTH_SECRET for each environment
# 3. Use strong passwords for MongoDB Atlas
# 4. Restrict CORS_ORIGINS in production
# 5. Keep your GEMINI_API_KEY secure
