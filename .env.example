# ExamReady AI - Environment Variables Template
# Copy this file to .env and fill in your values

# ==========================================
# MongoDB Configuration
# ==========================================

# Option 1: Local MongoDB
MONGODB_URI

# Database Name
DB_NAME=examready_db

# ==========================================
# Application URL
# ==========================================

# For development
NEXT_PUBLIC_BASE_URL=h
# For production (change to your domain)
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ==========================================
# Google Gemini AI Configuration
# ==========================================

# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=xyz


# ==========================================
# Authentication Secret
# ==========================================

# JWT Secret for authentication (MUST BE SECURE)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=xyz

# Example secure key (DO NOT USE THIS - Generate your own):
# NEXTAUTH_SECRET=xyz

# ==========================================
# CORS Configuration
# ==========================================

# Allow all origins (development only)
CORS_ORIGINS=*

# For production, specify your domain:
# CORS_ORIGINS=https://yourdomain.com

# ==========================================
# IMPORTANT SECURITY NOTES
# ==========================================

# 1. NEVER commit .env file to Git
# 2. Generate a unique NEXTAUTH_SECRET for each environment
# 3. Use strong passwords for MongoDB Atlas
# 4. Restrict CORS_ORIGINS in production
# 5. Keep your GEMINI_API_KEY secure
